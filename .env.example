# ========== 前端（公开，构建时注入） ==========
# Supabase 项目 URL 与 anon key（在 Supabase 后台 Project Settings → API 获取）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ========== 服务端（仅 Vercel/本地，含密钥） ==========
# Supabase 后台 Project Settings → API 获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# DeepSeek API Key（https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your-deepseek-key

# Finnhub API Key（https://finnhub.io 注册免费获取）
FINNHUB_API_KEY=your-finnhub-key

# Notion Integration Token（在 https://www.notion.so/my-integrations 创建）
# 用户在 App 设置里填写自己的 token，这里为本地默认值占位
NOTION_TOKEN=your-notion-token
